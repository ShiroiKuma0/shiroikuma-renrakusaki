<?xml version="1.0" encoding="utf-8"?>
<!-- A pressable settings row (black-yellow theme, "every pressable row is a pill"): the label sits
     inside an OUTLINED pill as wide as the label — never stretched across the line, never filled;
     3dp frame + bold for the main action of its section, 1.25dp + normal otherwise — with a › inside
     the pill when the row opens something, and its explanation beneath in the settings-note dim gold,
     aligned with the label. A thin dim-gold rule runs down the left of pill + explanation when there
     is an explanation. Only the pill takes taps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/theme_action_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="3dp"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="3dp"
    tools:ignore="MissingDefaultResource">

    <View
        android:id="@+id/theme_action_rule"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/theme_action_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="9dp"
            android:paddingEnd="16dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/theme_action_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/theme_action_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:includeFontPadding="false"
                android:text="›"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/theme_action_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="3dp"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
