<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: one call in the contact screen's 発着信履歴 — denwa's item_recent_call without the avatar,
     the name and the ⋮ (every row is this contact). Keep it in step with denwa's layout. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contact_call_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="@dimen/medium_margin"
    android:paddingBottom="@dimen/medium_margin">

    <ImageView
        android:id="@+id/contact_call_sim_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/activity_margin"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_sim_vector"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/contact_call_time"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/contact_call_time"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/contact_call_sim_id"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:textSize="@dimen/small_text_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/contact_call_sim_image"
        app:layout_constraintEnd_toEndOf="@+id/contact_call_sim_image"
        app:layout_constraintStart_toStartOf="@+id/contact_call_sim_image"
        app:layout_constraintTop_toTopOf="@+id/contact_call_sim_image"
        tools:text="1"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/contact_call_type"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/tiny_margin"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_call_missed_vector"
        app:layout_constraintBottom_toBottomOf="@+id/contact_call_time"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@+id/contact_call_sim_image"
        app:layout_constraintTop_toTopOf="@+id/contact_call_time"
        app:layout_goneMarginStart="@dimen/activity_margin" />

    <TextView
        android:id="@+id/contact_call_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tiny_margin"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/contact_call_type"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="午後三時三十四分" />

    <TextView
        android:id="@+id/contact_call_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:alpha="0.6"
        android:text="•"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="@id/contact_call_time"
        app:layout_constraintStart_toEndOf="@+id/contact_call_time"
        app:layout_constraintTop_toTopOf="@id/contact_call_time" />

    <TextView
        android:id="@+id/contact_call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:alpha="0.6"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="@id/contact_call_time"
        app:layout_constraintStart_toEndOf="@id/contact_call_separator"
        app:layout_constraintTop_toTopOf="@id/contact_call_time"
        tools:text="（三分十三秒）" />

    <!-- Which of the contact's numbers the call used; shown only when the contact has more than one. -->
    <TextView
        android:id="@+id/contact_call_number_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/normal_margin"
        android:maxLines="1"
        android:textSize="@dimen/smaller_text_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/contact_call_time"
        app:layout_constraintEnd_toStartOf="@+id/contact_call_location"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/contact_call_duration"
        app:layout_constraintTop_toTopOf="@id/contact_call_time"
        tools:text="携帯 2"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/contact_call_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/normal_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:alpha="0.6"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="@id/contact_call_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/contact_call_time"
        tools:text="チェコ" />

    <View
        android:id="@+id/contact_call_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
