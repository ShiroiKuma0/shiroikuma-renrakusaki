<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: one call in the contact screen's 発着信履歴 — the three-line row 電話, 臨電話 and 連絡先 share
     (denwa's item_recent_call), without the picture, the name line and the ⋮: every row here is this
     contact. Keep it in step with denwa's layout.

         +420 735 160 301 · 携帯                         ✉  ☎
         [1] ↗ 午後五時二分 · （十七秒）                  チェコ

     The ✉ and the ☎ live on the number line only and are as tall as it. The line under the row is
     inset from both edges and hidden under a day's last call (ViewContactActivity.callRow). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contact_call_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/contact_call_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginTop="@dimen/small_margin"
        android:layout_marginEnd="@dimen/small_margin"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:textDirection="firstStrongLtr"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintEnd_toStartOf="@+id/contact_call_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="+420 735 160 301 · 携帯" />

    <ImageView
        android:id="@+id/contact_call_message"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/send_sms"
        android:src="@drawable/ic_message_outline"
        app:layout_constraintBottom_toBottomOf="@id/contact_call_number"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/contact_call_call"
        app:layout_constraintTop_toTopOf="@id/contact_call_number" />

    <ImageView
        android:id="@+id/contact_call_call"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/activity_margin"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/call"
        android:src="@drawable/ic_phone_vector"
        app:layout_constraintBottom_toBottomOf="@id/contact_call_number"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/contact_call_number" />

    <ImageView
        android:id="@+id/contact_call_sim_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/activity_margin"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_sim_vector"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/contact_call_time"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/contact_call_time"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/contact_call_sim_id"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:textSize="@dimen/small_text_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/contact_call_sim_image"
        app:layout_constraintEnd_toEndOf="@+id/contact_call_sim_image"
        app:layout_constraintStart_toStartOf="@+id/contact_call_sim_image"
        app:layout_constraintTop_toTopOf="@+id/contact_call_sim_image"
        tools:text="1"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/contact_call_type"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/tiny_margin"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_call_missed_vector"
        app:layout_constraintBottom_toBottomOf="@+id/contact_call_time"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@+id/contact_call_sim_image"
        app:layout_constraintTop_toTopOf="@+id/contact_call_time"
        app:layout_goneMarginStart="@dimen/activity_margin" />

    <TextView
        android:id="@+id/contact_call_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tiny_margin"
        android:layout_marginBottom="@dimen/small_margin"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/contact_call_type"
        app:layout_constraintTop_toBottomOf="@id/contact_call_number"
        tools:text="午後三時三十四分" />

    <TextView
        android:id="@+id/contact_call_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:text="·"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="@id/contact_call_time"
        app:layout_constraintStart_toEndOf="@+id/contact_call_time"
        app:layout_constraintTop_toTopOf="@id/contact_call_time" />

    <TextView
        android:id="@+id/contact_call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="@id/contact_call_time"
        app:layout_constraintStart_toEndOf="@id/contact_call_separator"
        app:layout_constraintTop_toTopOf="@id/contact_call_time"
        tools:text="（三分十三秒）" />

    <TextView
        android:id="@+id/contact_call_location"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/normal_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="@id/contact_call_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/contact_call_duration"
        app:layout_constraintTop_toTopOf="@id/contact_call_time"
        tools:text="チェコ" />

    <View
        android:id="@+id/contact_call_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
