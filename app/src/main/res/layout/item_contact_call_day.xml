<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: a day heading in the contact screen's 発着信履歴 — denwa's item_recents_date. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/contact_call_day_divider"
        android:layout_width="match_parent"
        android:layout_height="4dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/activity_margin"
        android:layout_marginVertical="@dimen/normal_margin"
        android:orientation="vertical">

        <TextView
            android:id="@+id/contact_call_day_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            tools:text="今日" />

        <View
            android:id="@+id/contact_call_day_underline"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/tiny_margin" />

    </LinearLayout>

</LinearLayout>
