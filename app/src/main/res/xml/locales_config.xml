<?xml version="1.0" encoding="utf-8"?>
<!-- Fork (+138, cut in +140): the languages the app offers — in its own picker (UI page → App language, which
     reads this file) and on the system's per-app language screen. Japanese and English only: the fork's own
     screens exist in these two, and every other language showed them in English. The other translations
     stay in the package but are not offered. Written by hand: generateLocaleConfig is off. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ja" />
    <locale android:name="en" />
</locale-config>
